[Unit]
Description=Xuesheng Study Platform
After=network.target

[Service]
Type=simple
# 改成你实际的部署目录
WorkingDirectory=/opt/xuesheng
# 服务端口
Environment=PORT=8790
# 数据库存放目录（自动创建）
Environment=XS_DATA_DIR=/opt/xuesheng/data
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
